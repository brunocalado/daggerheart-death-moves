{{!-- An ApplicationV2 Handlebars part must render exactly one root element. --}}
<section class="dm-slots">
    <header class="dialog-header">
        <h1>{{localize "DEATH_OPTIONS.Settings.ItemSources.Title"}}</h1>
    </header>

    <p class="dm-dialog__hint">{{localize "DEATH_OPTIONS.Settings.ItemSources.Intro"}}</p>

    {{#each fields}}
    <div class="form-group">
        <label>{{this.label}}</label>
        <div class="form-fields">
            <div class="dm-slot {{#unless this.resolved}}dm-slot--missing{{/unless}}" data-drop-key="{{this.key}}">
                <img class="dm-slot__img" src="{{this.img}}" alt="">
                <div class="dm-slot__info">
                    <span class="dm-slot__name">{{this.name}}</span>
                    <span class="dm-slot__uuid">
                        {{#if this.resolved}}{{this.uuid}}{{else}}{{localize "DEATH_OPTIONS.Settings.ItemSources.Missing"}}{{/if}}
                    </span>
                </div>
                {{#unless this.isDefault}}
                <button type="button" class="dm-slot__reset" data-action="resetSlot" data-key="{{this.key}}"
                        data-tooltip="{{localize "DEATH_OPTIONS.Settings.ItemSources.ResetSlot"}}">
                    <i class="fa-solid fa-rotate-left" inert></i>
                </button>
                {{/unless}}
            </div>
        </div>
        <p class="hint">{{this.hint}}</p>
    </div>
    {{/each}}

    <footer class="form-footer">
        <button type="button" data-action="resetAll">
            <i class="fa-solid fa-rotate-left" inert></i>
            {{localize "DEATH_OPTIONS.Settings.ItemSources.ResetAll"}}
        </button>
    </footer>
</section>
