{{!-- Appended to the system's own Daggerheart menu, so it inherits that app's styling. --}}
<fieldset class="daggerheart-death-moves dm-menu">
    <legend>{{legend}}</legend>
    <button type="button" class="dm-menu__btn" data-dm-action="trigger">
        <i class="fa-solid fa-skull" inert></i>
        <span>{{label}}</span>
    </button>
</fieldset>
