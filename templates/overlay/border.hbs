{{!--
    Pulsing screen edge shown while a die is in the air. The frame is drawn by a
    huge outward box-shadow on an inset element, which is what gives the inner
    corners their radius.
--}}
<div id="{{id}}" class="daggerheart-death-moves dm-border dm-border--{{type}}">
    {{#if label}}<span class="dm-border__label">{{label}}</span>{{/if}}
</div>
